meta {
  name: upload icon
  type: http
  seq: 7
}

post {
  url: {{baseurl}}/v1/software/:instance/icon
  body: multipartForm
  auth: inherit
}

params:path {
  instance: mastodon
}

body:multipart-form {
  file: @file(/home/emanuel/Downloads/logo-purple.svg)
}

settings {
  encodeUrl: true
  timeout: 0
}
