meta {
  name: Get instances
  type: http
  seq: 1
}

get {
  url: {{baseurl}}/v1/instances?sort=softwareVersion&software=mastodon&order=asc
  body: none
  auth: inherit
}

params:query {
  sort: softwareVersion
  software: mastodon
  order: asc
  ~search: pixelix
}

settings {
  encodeUrl: true
  timeout: 0
}
